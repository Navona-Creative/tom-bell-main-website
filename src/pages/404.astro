---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostGrid from '../components/PostGrid.astro';
import { posts } from '../lib/posts';
---
<Base title="Page not found | Tom Bell Cabinetry" noindex solidHeader>
  <PageHero title="We couldn't find that page" intro="It may have moved when we rebuilt the site. Try one of these instead.">
    <div style="display:flex;gap:24px;flex-wrap:wrap"><a class="btn btn--solid" href="/">Home</a><a class="btn" href="/home-renovation-nashville/">Services</a><a class="btn" href="/contact/">Contact</a></div>
  </PageHero>
  <section class="section" style="padding-top:20px"><div class="wrap"><PostGrid posts={posts.slice(0, 3)} heading="h3" /></div></section>
</Base>
