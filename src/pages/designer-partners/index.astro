---
// Designer Partner Program. Linked from outreach emails only: kept out of the nav, but indexed.
// Uses the homepage motion system (src/scripts/motion.ts): hero line reveal, word scrub,
// sticky image swap, process line, Instagram marquee.
// Hero images must be magazine quality. Never use vaulted.webp as a hero.
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Reviews from '../../components/Reviews.astro';
import InstagramStrip from '../../components/InstagramStrip.astro';
import { site } from '../../site';

const url = `${site.url}/designer-partners/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'The Tom Bell Designer Partner Program',
  url,
  about: { '@id': `${site.url}/#business` },
};

const reasons = [
  { i: 1, img: 'builtins', alt: 'Walnut wall unit with open shelving and media storage', title: 'White-glove, start to finish',
    text: 'We handle everything from the first site measure to the final install.' },
  { i: 2, img: 'g1', alt: 'Walnut library with arched shelving', title: 'A client-ready team',
    text: "Our people are professional and communicative, and we're comfortable in high-end homes and with high-expectation clients." },
  { i: 3, img: 'millwork', alt: 'Slatted wood ceiling detail', title: 'Truly custom',
    text: 'Everything is built to your design intent in our Nashville-area shop.' },
  { i: 4, img: 'cabinets', alt: 'Custom bathroom vanity with a tall walnut cabinet', title: 'Your client stays your client',
    text: "We never go around you. You're kept in the loop at every step." },
  { i: 5, img: 'g7', alt: 'Walnut-paneled room with black steel windows', title: 'A rewarding partnership',
    text: 'Every project you send our way earns a generous referral fee.' },
];

const steps = [
  ['Join', 'Fill out the short form below.'],
  ['Connect', "A brief call to learn about your clientele, your process, and whether we're a good fit. We'll walk you through the partner terms."],
  ['Refer', 'Introduce us to clients who need cabinetry. Every project earns a generous referral fee, tailored to its scope.'],
  ['Earn', "Your referral fee is paid within 30 days of the client's final payment."],
];
---
<Base
  title="Designer Partner Program | Tom Bell Cabinetry, Nashville"
  description="Custom cabinetry for your most discerning clients. Interior designers: join the Tom Bell Designer Partner Program for white-glove service and a generous referral fee."
  schema={schema}
>
  <link slot="head" rel="preload" as="image" href="/img/hero-kitchen.webp" imagesrcset="/img/hero-kitchen-sm.webp 1280w, /img/hero-kitchen.webp 2400w" imagesizes="100vw">

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero__media">
      <img data-hero-img src="/img/hero-kitchen.webp" srcset="/img/hero-kitchen-sm.webp 1280w, /img/hero-kitchen.webp 2400w" sizes="100vw" alt="Bright transitional kitchen with inset shaker cabinetry and a large marble island" fetchpriority="high" width="2400" height="1600">
    </div>
    <div class="hero__shade"></div>
    <div class="hero__content" data-hero-content>
      <div class="wrap">
        <div>
          <p class="eyebrow" data-hero-fade>For interior designers</p>
          <h1><span class="line" data-hero-line><span>The Designer</span></span><span class="line" data-hero-line><span>Partner Program</span></span></h1>
        </div>
        <div class="hero__side" data-hero-fade>
          <p>Custom cabinetry for your most discerning clients, from a team you can confidently put in front of them.</p>
          <a class="link-line" href="#join">Become a Partner <Arrow /></a>
        </div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"></div>
  </section>

  <!-- STATEMENT -->
  <section class="statement" aria-labelledby="st-h">
    <div class="wrap">
      <h2 class="sr-only" id="st-h">About the program</h2>
      <p class="big" data-scrub-words>Your clients trust you with their homes. You need a cabinetry partner who protects that trust.</p>
      <div data-fade>
        <p class="statement__sub">Tom Bell Cabinetry is led by business professionals with backgrounds in sales and client service. We communicate like your firm does, show up polished and prepared, and treat every home like the luxury project it is.</p>
      </div>
    </div>
  </section>

  <!-- WHY (sticky image swap) -->
  <section class="craft light" aria-labelledby="why-h">
    <div class="wrap">
      <div class="craft__sticky">
        <div class="craft__frame">
          <img class="is-on" data-i="0" src="/img/kitchen.webp" alt="Walnut kitchen island with a farmhouse sink" loading="lazy" width="1800" height="1350">
          {reasons.map((r) => <img data-i={String(r.i)} src={`/img/${r.img}.webp`} alt={r.alt} loading="lazy" width="1400" height="1400">)}
        </div>
      </div>
      <div class="craft__steps">
        <div class="craft__intro" data-i="0" data-craft-step>
          <h2 class="h2" id="why-h">Why designers<br>partner with us</h2>
          <p>A cabinetry partner that makes you look good in front of your clients.</p>
        </div>
        {reasons.map((r) => (
          <div class="craft__step" data-i={String(r.i)} data-craft-step>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="process" aria-labelledby="pr-h">
    <div class="wrap">
      <div class="process__head" data-fade>
        <h2 class="h2" id="pr-h">How it works</h2>
        <p class="muted">Four simple steps, and a partnership built around your clients.</p>
      </div>
      <ol class="steps">
        <li class="steps__line" aria-hidden="true"><i id="stepLine"></i></li>
        {steps.map(([t, d], n) => <li class="step"><span class="step__n">0{n + 1}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <Reviews />
  <InstagramStrip />

  <!-- JOIN -->
  <section class="join light" id="join" aria-labelledby="join-h">
    <div class="wrap">
      <div class="split">
        <aside data-fade>
          <h2 class="h2" id="join-h">Become a partner</h2>
          <p class="muted" style="margin:0 0 30px;max-width:36ch">Share a few details and we'll reach out within one business day to schedule a quick intro call.</p>
          <h3 class="h3">Prefer to talk now?</h3>
          <p class="note" style="margin:0"><a href={site.phoneHref}>{site.phone}</a></p>
        </aside>

        <form class="form" id="partner" method="post" action="/api/designer" novalidate data-fade>
          <p class="muted field--full" style="margin:0 0 6px;font-size:14px">Fields marked * are required.</p>
          <div class="field"><label for="p-name">Name *</label><input id="p-name" name="name" autocomplete="name" required></div>
          <div class="field"><label for="p-company">Company *</label><input id="p-company" name="company" autocomplete="organization" required></div>
          <div class="field"><label for="p-email">Email *</label><input id="p-email" name="email" type="email" autocomplete="email" required></div>
          <div class="field"><label for="p-phone">Phone</label><input id="p-phone" name="phone" type="tel" autocomplete="tel"></div>
          <p class="muted field--full" style="font-size:13px;margin:0">See our <a href="/privacy-policy/" style="text-decoration:underline">Privacy Policy</a> and <a href="/terms/" style="text-decoration:underline">Terms</a>.</p>
          <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <div class="field--full"><div class="cf-turnstile" data-sitekey="0x4AAAAAAF6bxwxkVgXSfrfZ" data-theme="light"></div></div>
          <div class="form__msg" id="formMsg" role="alert"></div>
          <div class="field--full"><button class="btn btn--solid" type="submit">Become a Partner</button></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('partner') as HTMLFormElement;
  const msg = document.getElementById('formMsg')!;
  const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
  const fail = (t: string) => { msg.textContent = t; msg.classList.add('is-on'); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.classList.remove('is-on');
    if (!val('name') || !val('company') || !/^\S+@\S+\.\S+$/.test(val('email'))) return fail('Please add your name, company and email.');
    const token = (form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null)?.value;
    if (!token) return fail('Please complete the quick security check above the button.');
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      location.href = '/designer-partners/thank-you/';
    } catch {
      fail('Something went wrong. Please call or text (615) 469-2781, or try again.');
      btn.disabled = false; btn.textContent = 'Become a Partner';
      (window as any).turnstile?.reset();
    }
  });
</script>

<style>
.hero{position:relative;height:100vh;min-height:640px;overflow:hidden}
.hero__media{position:absolute;inset:0}
.hero__media img{width:100%;height:115%;object-fit:cover;object-position:50% 45%}
.hero__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,17,15,.62) 0%,rgba(20,17,15,.12) 28%,rgba(20,17,15,.2) 52%,rgba(20,17,15,.86) 100%)}
.hero__content{position:absolute;left:0;right:0;bottom:clamp(48px,9vh,110px)}
.hero__content .wrap{display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px}
.eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--ivory);text-shadow:0 1px 14px rgba(0,0,0,.55);margin:0 0 18px}
.hero h1{font-size:clamp(48px,7.2vw,118px);line-height:.98;margin:0}
.hero h1 .line{display:block;overflow:hidden;padding-bottom:.06em}
.hero h1 .line>span{display:inline-block}
.hero__side{max-width:340px;padding-bottom:12px}
.hero__side p{margin:0 0 22px;color:var(--ivory-2)}
.scroll-cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);width:1px;height:56px;background:var(--line-d);overflow:hidden}
.scroll-cue::after{content:"";position:absolute;left:0;top:-50%;width:1px;height:50%;background:var(--ivory);animation:cue 2.2s cubic-bezier(.6,0,.3,1) infinite}
@keyframes cue{to{top:110%}}

.statement{padding:clamp(100px,16vh,200px) 0}
.statement .wrap{max-width:1180px}
.statement .big{font-family:var(--serif);font-weight:300;font-size:clamp(30px,3.7vw,56px);line-height:1.18;margin:0 0 44px}
.statement__sub{color:var(--stone);max-width:58ch;margin:0}

.craft .wrap{display:grid;grid-template-columns:1fr 1fr;gap:var(--pad)}
.craft__sticky{position:sticky;top:0;height:100vh;display:flex;align-items:center}
.craft__frame{position:relative;width:100%;aspect-ratio:4/5;max-height:78vh;overflow:hidden;background:var(--ivory-2)}
.craft__frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .9s ease,transform 1.6s ease;transform:scale(1.06)}
.craft__frame img.is-on{opacity:1;transform:scale(1)}
.craft__steps{padding:20vh 0}
.craft__intro{min-height:60vh;display:flex;flex-direction:column;justify-content:center}
.craft__intro p,.craft__step p{color:var(--stone-d);max-width:44ch;margin:0}
.craft__step{min-height:70vh;display:flex;flex-direction:column;justify-content:center;border-top:1px solid var(--line-l);padding:40px 0}
.craft__step h3{font-size:clamp(32px,3.2vw,48px);line-height:1.08;margin:0 0 16px}

.process{background:var(--ink-2);padding:clamp(100px,16vh,190px) 0}
.process__head{display:grid;grid-template-columns:1fr 1fr;gap:var(--pad);margin-bottom:clamp(60px,10vh,110px)}
.process__head .h2{margin:0}
.process__head p{margin:0;align-self:end;max-width:46ch}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--pad);position:relative;padding:48px 0 0;list-style:none;margin:0}
.steps__line{position:absolute;left:0;right:0;top:0;height:1px;background:var(--line-d)}
.steps__line i{position:absolute;inset:0;background:var(--brass);transform-origin:left}
.step__n{display:block;font-family:var(--serif);font-size:22px;color:var(--brass);margin-bottom:14px}
.step h3{font-weight:400;font-size:32px;line-height:1.15;margin:0 0 12px}
.step p{color:var(--stone);margin:0;max-width:34ch}

.join{padding:clamp(100px,16vh,180px) 0}

@media (max-width:1000px){
  .hero__content .wrap{grid-template-columns:1fr}
  .craft .wrap{grid-template-columns:1fr}
  .craft__sticky{position:relative;height:auto;padding-top:80px}
  .craft__frame{max-height:none}
  .craft__steps{padding:20px 0 80px}
  .craft__intro,.craft__step{min-height:auto;padding:44px 0}
  .process__head{grid-template-columns:1fr}
  .steps{grid-template-columns:1fr 1fr;gap:48px}
}
@media (max-width:640px){
  .steps{grid-template-columns:1fr}
  .scroll-cue{display:none}
}
</style>
