---
// Blog posts live at the site root (/<slug>/), exactly like the WordPress permalinks.
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { posts, fmtDate, readMins, type Post } from '../../lib/posts';
import { site } from '../../site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const idx = posts.findIndex((p) => p.slug === post.slug);
const related = [...posts.slice(idx + 1), ...posts.slice(0, idx)].slice(0, 3);
const url = `${site.url}/${post.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.seoDescription || post.excerpt,
    image: post.image ? `${site.url}${post.image}` : undefined,
    datePublished: post.date,
    dateModified: post.modified,
    author: { '@type': 'Person', name: site.owner, url: `${site.url}/about/` },
    publisher: { '@id': `${site.url}/#business` },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];
---
<Base
  title={post.seoTitle || `${post.title} - Tom Bell Cabinetry`}
  description={post.seoDescription || post.excerpt}
  image={post.image ?? undefined}
  type="article"
  schema={schema}
  solidHeader
>
  <article>
    <header class="post-head">
      <div class="wrap wrap--narrow">
        <p class="crumbs"><a href="/">Home</a> / <a href="/blog/">Journal</a></p>
        <h1>{post.title}</h1>
        <p class="post-meta"><time datetime={post.date}>{fmtDate(post.date)}</time> · {readMins(post.content)} min read · By <a href="/about/">{site.owner}</a></p>
      </div>
      {post.image && (
        <div class="wrap post-hero">
          <img src={post.image} alt={post.imageAlt} width={post.imageWidth ?? 1600} height={post.imageHeight ?? 1067} fetchpriority="high">
        </div>
      )}
    </header>
    <div class="post-body light">
      <div class="wrap">
        <div class="prose" set:html={post.content} />
        <aside class="post-cta">
          <p class="note" style="margin:0 0 18px">Planning a kitchen, cabinets or built-ins in Middle Tennessee?</p>
          <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center">
            <a class="btn btn--solid" href="/contact/">Request a Free Estimate</a>
            <a class="link-line" href={site.phoneHref}>Call or text {site.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section class="section" aria-labelledby="more-h">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:44px">
        <h2 class="h2" id="more-h" style="margin:0">More from the journal</h2>
        <a class="link-line" href="/blog/">All articles <Arrow /></a>
      </div>
      <PostGrid posts={related} heading="h3" />
    </div>
  </section>
  <CtaBand />
</Base>

<style>
.post-head{padding:calc(var(--bar-h) + 70px) 0 0}
.post-head h1{font-size:clamp(40px,5.2vw,78px);line-height:1.04;margin:0 0 20px}
.post-meta{color:var(--stone);font-size:14px;letter-spacing:.06em;margin:0 0 50px}
.post-meta a{border-bottom:1px solid var(--line-d)}
.post-hero img{width:100%;max-height:78vh;object-fit:cover}
.post-body{padding:clamp(70px,10vh,120px) 0}
.post-cta{max-width:720px;margin:60px auto 0;padding-top:36px;border-top:1px solid var(--line-l)}
</style>
