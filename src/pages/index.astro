---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Reviews from '../components/Reviews.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import CtaBand from '../components/CtaBand.astro';

const disciplines = [
  { title: 'Kitchens', img: 'kitchen', alt: 'Walnut kitchen island with a farmhouse sink', href: '/kitchen-remodeling-nashville/', link: 'Explore Kitchens',
    text: 'Kitchen remodeling in Nashville, planned around how your family cooks and gathers, with a clear scope and a clear price before work begins.' },
  { title: 'Cabinetry', img: 'cabinets', alt: 'Custom bathroom vanity with a tall walnut cabinet', href: '/custom-cabinets-nashville/', link: 'Explore Cabinetry', tall: true, flip: true,
    text: 'Custom cabinets for kitchens, baths and closets in frameless European, white shaker, custom inset and two-tone styles.' },
  { title: 'Millwork', img: 'millwork', alt: 'Slatted wood ceiling detail', href: '/custom-millwork-nashville/', link: 'Explore Millwork', tall: true,
    text: 'Paneling, slat ceilings, trim and architectural details that turn a room into a finished space.' },
  { title: 'Built-Ins', img: 'builtins', alt: 'Walnut wall unit with open shelving and media storage', href: '/custom-built-ins-nashville/', link: 'Explore Built-Ins', flip: true,
    text: 'Libraries, media walls, mudrooms and bars, fitted wall to wall and made to look like they were always there.' },
];

const work = [
  ['g1', 'Walnut library with arched shelving', 'Library'],
  ['g2', 'Vaulted white kitchen with a walnut island', 'Kitchen'],
  ['g3', 'Walnut media wall with carved panel doors', 'Media Wall'],
  ['g9', 'Walnut-paneled room with a glass door', 'Paneled Study'],
  ['g10', 'Tall walnut storage wall in a high-rise', 'Storage Wall'],
  ['g5', 'Open walnut vanity under a window', 'Primary Bath'],
  ['g8', 'Black double vanity with arched mirrors', 'Double Vanity'],
  ['g4', 'Walnut bar cabinet with pull-out drawers', 'Bar Cabinet'],
  ['g7', 'Walnut-paneled room with black steel windows', 'Great Room'],
  ['g11', 'Walnut kitchen run with long drawers', 'Kitchen Run'],
  ['g12', 'Walnut island with an open shelf base', 'Island Detail'],
  ['g14', 'Wood slat ceiling detail', 'Slat Detail'],
];

const craft = [
  { i: 1, img: 'slab', alt: 'Hands guiding a hardwood slab through a saw', title: 'The right material for each part',
    text: "We use solid hardwood where it performs best, like face frames, stained doors and edges. For painted panels we often choose high-density fiberboard (HDF), which stays flat and won't open up at the joints the way solid wood can." },
  { i: 2, img: 'g6', alt: 'Solid wood drawer boxes with dovetail joinery', title: 'Boxes that hold their shape',
    text: 'Our cabinet boxes are built from plywood rather than particleboard, so they stay square, hold screws and hardware, and stand up to Tennessee humidity.' },
  { i: 3, img: 'grain', alt: 'Close-up of walnut grain and carved wood panels', title: 'Designed for your room',
    text: 'Door style, wood species and finish are chosen with you, whether that is frameless European, white shaker, custom inset or a two-tone kitchen.' },
];
---
<Base
  title="Custom Cabinet Maker in Nashville, TN | Tom Bell Cabinetry"
  description="Cabinet maker in Nashville crafting custom kitchen cabinets, remodels & millwork. Also serving Belle Meade, Brentwood, Franklin & Middle TN."
>
  <link slot="head" rel="preload" as="image" href="/img/hero.webp" imagesrcset="/img/hero-sm.webp 1280w, /img/hero.webp 2400w" imagesizes="100vw">

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero__media">
      <img data-hero-img src="/img/hero.webp" srcset="/img/hero-sm.webp 1280w, /img/hero.webp 2400w" sizes="100vw" alt="Warm wood kitchen cabinetry with a stone backsplash and under-cabinet lighting" fetchpriority="high" width="2400" height="1600">
    </div>
    <div class="hero__shade"></div>
    <div class="hero__content" data-hero-content>
      <div class="wrap">
        <h1><span class="line" data-hero-line><span>Custom cabinetry,</span></span><span class="line" data-hero-line><span>made in Nashville</span></span></h1>
        <div class="hero__side" data-hero-fade>
          <p>Kitchens, cabinets, millwork and built-ins, designed, built and installed by our own team for homes across Middle Tennessee.</p>
          <a class="link-line" href="#work">See Our Work <Arrow /></a>
        </div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"></div>
  </section>

  <!-- STATEMENT -->
  <section class="statement light" aria-labelledby="st-h">
    <div class="wrap">
      <h2 class="sr-only" id="st-h">About Tom Bell Cabinetry</h2>
      <p class="big" data-scrub-words>Every cabinet we make is built in our Madison shop, not shipped in a box from overseas. We design it, build it and install it ourselves, for homes from Belle Meade to Franklin.</p>
      <a class="btn" href="/about/">About Us</a>
    </div>
  </section>

  <!-- DISCIPLINES -->
  <section class="disc" aria-labelledby="disc-h">
    <div class="wrap">
      <div class="disc__head" data-fade>
        <h2 class="h2" id="disc-h">Custom cabinetry, millwork<br>and built-ins</h2>
        <p class="muted">From a single vanity to a whole-home renovation, every piece is drawn for the room it lives in.</p>
      </div>
      {disciplines.map((d) => (
        <article class:list={['block', { 'block--tall': d.tall, 'is-flip': d.flip }]}>
          <div class="block__media" data-reveal><img src={`/img/${d.img}.webp`} alt={d.alt} loading="lazy" width="1400" height="1400"></div>
          <div class="block__text" data-fade>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
            <a class="link-line" href={d.href}>{d.link} <Arrow /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CRAFT -->
  <section class="craft light" aria-labelledby="craft-h">
    <div class="wrap">
      <div class="craft__sticky">
        <div class="craft__frame">
          <img class="is-on" data-i="0" src="/img/craft.webp" alt="Craftsman marking a board with a pencil" loading="lazy" width="1800" height="1200">
          {craft.map((c) => <img data-i={String(c.i)} src={`/img/${c.img}.webp`} alt={c.alt} loading="lazy" width="1600" height="1200">)}
        </div>
      </div>
      <div class="craft__steps">
        <div class="craft__intro" data-i="0" data-craft-step>
          <h2 class="h2" id="craft-h">The details<br>inside the cabinet</h2>
          <p>Some of what makes a cabinet last is hidden once it's installed. Here is what goes into ours.</p>
        </div>
        {craft.map((c) => (
          <div class="craft__step" data-i={String(c.i)} data-craft-step>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK (horizontal) -->
  <section class="work" id="work" aria-labelledby="work-h">
    <div class="work__pin">
      <div class="work__head">
        <h2 class="h2" id="work-h">Recent projects</h2>
        <div class="counter" aria-hidden="true"><b id="ctr">01</b> <span>/ <span id="ctrTot">12</span></span></div>
      </div>
      <div class="track-scroll" id="trackScroll">
      <div class="track" id="track">
        {work.map(([img, alt, cap]) => (
          <figure class="work-card"><img src={`/img/${img}.webp`} alt={alt} loading="lazy" width="960" height="1200"><figcaption>{cap}</figcaption></figure>
        ))}
      </div>
      </div>
      <div class="progress" aria-hidden="true"><i id="prog"></i></div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process" aria-labelledby="pr-h">
    <div class="wrap">
      <div class="process__head" data-fade>
        <h2 class="h2" id="pr-h">How a project works</h2>
        <p class="muted">A clear plan, premium materials and careful installation, with respect for your time, your home and your budget.</p>
      </div>
      <ol class="steps">
        <li class="steps__line" aria-hidden="true"><i id="stepLine"></i></li>
        <li class="step"><h3>Request a free estimate</h3><p>Precise measurements, clear pricing and expert guidance, with no pressure.</p></li>
        <li class="step"><h3>Approve your custom plan</h3><p>A detailed design and clear scope of work, tailored to your home, for you to approve.</p></li>
        <li class="step"><h3>Enjoy your new space</h3><p>We build and install everything, then you get back to gathering with family and friends.</p></li>
      </ol>
    </div>
  </section>

  <Reviews />
  <InstagramStrip />
  <CtaBand />
</Base>

<style>
.hero{position:relative;height:100vh;min-height:640px;overflow:hidden}
.hero__media{position:absolute;inset:0}
.hero__media img{width:100%;height:115%;object-fit:cover;object-position:50% 45%}
.hero__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,17,15,.62) 0%,rgba(20,17,15,.12) 28%,rgba(20,17,15,.2) 52%,rgba(20,17,15,.86) 100%)}
.hero__content{position:absolute;left:0;right:0;bottom:clamp(48px,9vh,110px)}
.hero__content .wrap{display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px}
.hero h1{font-size:clamp(48px,7.6vw,124px);line-height:.98;margin:0}
.hero h1 .line{display:block;overflow:hidden;padding-bottom:.06em}
.hero h1 .line>span{display:inline-block}
.hero__side{max-width:340px;padding-bottom:12px}
.hero__side p{margin:0 0 22px;color:var(--ivory-2)}
.scroll-cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);width:1px;height:56px;background:var(--line-d);overflow:hidden}
.scroll-cue::after{content:"";position:absolute;left:0;top:-50%;width:1px;height:50%;background:var(--ivory);animation:cue 2.2s cubic-bezier(.6,0,.3,1) infinite}
@keyframes cue{to{top:110%}}

.statement{padding:clamp(100px,16vh,200px) 0}
.statement .wrap{max-width:1180px}
.statement .big{font-family:var(--serif);font-weight:300;font-size:clamp(30px,3.7vw,56px);line-height:1.18;margin:0 0 44px}

.disc{padding:clamp(80px,12vh,160px) 0 40px}
.disc__head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:clamp(60px,10vh,120px)}
.disc__head .h2{margin:0}
.disc__head p{max-width:360px;margin:0}
.block{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--pad);align-items:center;margin-bottom:clamp(90px,16vh,200px)}
.block__media{grid-column:1 / span 7;position:relative;overflow:hidden;aspect-ratio:4/3}
.block__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.block--tall .block__media{aspect-ratio:4/5;grid-column:2 / span 5}
.block__text{grid-column:9 / span 4}
.block.is-flip .block__media{grid-column:6 / span 7;order:2}
.block.is-flip.block--tall .block__media{grid-column:7 / span 5}
.block.is-flip .block__text{grid-column:1 / span 4;grid-row:1;order:1}
.block h3{font-size:clamp(56px,7vw,112px);line-height:.95;margin:0 0 26px}
.block p{color:var(--stone);margin:0 0 30px;max-width:40ch}

.craft .wrap{display:grid;grid-template-columns:1fr 1fr;gap:var(--pad)}
.craft__sticky{position:sticky;top:0;height:100vh;display:flex;align-items:center}
.craft__frame{position:relative;width:100%;aspect-ratio:4/5;max-height:78vh;overflow:hidden;background:var(--ivory-2)}
.craft__frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .9s ease,transform 1.6s ease;transform:scale(1.06)}
.craft__frame img.is-on{opacity:1;transform:scale(1)}
.craft__steps{padding:20vh 0}
.craft__intro{min-height:60vh;display:flex;flex-direction:column;justify-content:center}
.craft__intro p,.craft__step p{color:var(--stone-d);max-width:44ch;margin:0}
.craft__step{min-height:70vh;display:flex;flex-direction:column;justify-content:center;border-top:1px solid var(--line-l);padding:40px 0}
.craft__step h3{font-size:clamp(32px,3.2vw,48px);line-height:1.08;margin:0 0 16px}

.work{position:relative;overflow:hidden}
.work__pin{height:100vh;display:flex;flex-direction:column;justify-content:center}
.work__head{display:flex;justify-content:space-between;align-items:end;padding:0 var(--pad);margin-bottom:36px;gap:24px}
.work__head .h2{margin:0}
.counter{font-family:var(--serif);font-size:28px;font-weight:300;white-space:nowrap}
.counter b{font-weight:400}
.counter span{color:var(--stone)}
.track-scroll{overflow-x:auto;scrollbar-width:thin;-webkit-overflow-scrolling:touch}
.track-scroll.is-pinned{overflow:visible}
.track{display:flex;gap:28px;padding:0 var(--pad);width:max-content;align-items:center}
.work-card{flex:0 0 auto;height:min(62vh,640px);overflow:hidden;position:relative;margin:0}
.work-card img{height:100%;width:auto;object-fit:cover}
.work-card figcaption{position:absolute;left:18px;bottom:16px;font-size:11px;letter-spacing:.24em;text-transform:uppercase;text-shadow:0 1px 12px rgba(0,0,0,.5)}
.progress{margin:34px var(--pad) 0;height:1px;background:var(--line-d);position:relative}
.progress i{position:absolute;inset:0;background:var(--ivory);transform-origin:left;transform:scaleX(0)}

.process{background:var(--ink-2);padding:clamp(100px,16vh,190px) 0}
.process__head{display:grid;grid-template-columns:1fr 1fr;gap:var(--pad);margin-bottom:clamp(60px,10vh,110px)}
.process__head .h2{margin:0}
.process__head p{margin:0;align-self:end;max-width:46ch}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--pad);position:relative;padding:48px 0 0;list-style:none;margin:0}
.steps__line{position:absolute;left:0;right:0;top:0;height:1px;background:var(--line-d)}
.steps__line i{position:absolute;inset:0;background:var(--brass);transform-origin:left}
.step h3{font-weight:400;font-size:32px;line-height:1.15;margin:0 0 12px}
.step p{color:var(--stone);margin:0;max-width:34ch}

@media (max-width:1000px){
  .hero__content .wrap{grid-template-columns:1fr}
  .block,.block.is-flip{grid-template-columns:1fr;gap:30px}
  .block .block__media,.block.is-flip .block__media,.block--tall .block__media,.block.is-flip.block--tall .block__media{grid-column:1;order:1}
  .block .block__text,.block.is-flip .block__text{grid-column:1;grid-row:auto;order:2}
  .craft .wrap{grid-template-columns:1fr}
  .craft__sticky{position:relative;height:auto;padding-top:80px}
  .craft__frame{max-height:none}
  .craft__steps{padding:20px 0 80px}
  .craft__intro,.craft__step{min-height:auto;padding:44px 0}
  .process__head{grid-template-columns:1fr}
  .steps{grid-template-columns:1fr;gap:48px}
}
@media (max-width:640px){
  .disc__head,.work__head{flex-direction:column;align-items:flex-start}
  .work-card{height:52vh}
  .scroll-cue{display:none}
}
</style>
