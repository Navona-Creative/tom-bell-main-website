---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../site';
---
<Base title="Thank You - Tom Bell Cabinetry" description="Thanks for reaching out to Tom Bell Cabinetry & Custom." noindex solidHeader reveal={false}>
  <PageHero
    title="Thank you"
    intro="Thank you for reaching out to Tom Bell Cabinetry & Custom. We're looking forward to helping bring your project to life."
  />

  <section class="section light" style="padding-top:clamp(60px,9vh,100px)">
    <div class="wrap">
      <div class="split">
        <h2 class="h2">What happens next</h2>
        <div>
          <p class="note" style="margin:0 0 24px">Matt will review your request and reach out, usually within one business day, to talk through your project and set up a time to measure.</p>
          <p class="muted" style="margin:0 0 28px">Need to reach us sooner? Call or text {site.phone}.</p>
          <a class="btn btn--solid" href={site.phoneHref}>Call or text {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap">
      <div>
        <h2 class="h2" style="margin-bottom:10px">See our latest work</h2>
        <p class="muted" style="margin:0">Pictures of our latest projects, posted on Instagram.</p>
      </div>
      <a class="btn" href={site.social.instagram}>{site.social.instagramHandle}</a>
    </div>
  </section>
</Base>
