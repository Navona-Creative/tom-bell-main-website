---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../site';
---
<Base title="Thank You - Tom Bell Cabinetry" description="Thanks for reaching out to Tom Bell Cabinetry & Custom." noindex solidHeader>
  <PageHero
    title="Thank you"
    intro="Thank you for reaching out to Tom Bell Cabinetry & Custom. We're looking forward to helping bring your project to life."
  />

  <section class="section light" style="padding-top:clamp(60px,9vh,100px)">
    <div class="wrap">
      <div class="split">
        <div>
          <h2 class="h2">Prefer a quick phone call?</h2>
          <p class="muted" style="max-width:44ch">If you'd like to connect sooner, grab a time on our calendar. It's the fastest way to talk through your project and next steps. If you'd rather not schedule right now, no problem. We'll review your request and reach out shortly.</p>
        </div>
        <div class="booking">
          <iframe src={site.bookingWidget} title="Schedule a call with Tom Bell Cabinetry" loading="lazy" style="width:100%;border:none;min-height:760px;background:#fff"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap">
      <div>
        <h2 class="h2" style="margin-bottom:10px">See our latest work</h2>
        <p class="muted" style="margin:0">Pictures of our latest projects, posted on Instagram.</p>
      </div>
      <a class="btn" href={site.social.instagram}>{site.social.instagramHandle}</a>
    </div>
  </section>
</Base>
