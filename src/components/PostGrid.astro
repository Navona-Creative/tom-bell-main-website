---
import { fmtDate, type Post } from '../lib/posts';
interface Props { posts: Post[]; heading?: 'h2' | 'h3'; eager?: number }
const { posts, heading = 'h2', eager = 0 } = Astro.props;
const H = heading;
---
<div class="posts">
  {posts.map((p, i) => (
    <article class="post-card">
      <a href={`/${p.slug}/`} class="post-card__img" tabindex="-1" aria-hidden="true">
        {p.image && <img src={p.image} alt="" loading={i < eager ? 'eager' : 'lazy'} width="1600" height="1067">}
      </a>
      <time datetime={p.date}>{fmtDate(p.date)}</time>
      <H><a href={`/${p.slug}/`}>{p.title}</a></H>
      <p>{p.excerpt}</p>
    </article>
  ))}
</div>
